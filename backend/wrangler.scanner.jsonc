{
  "name": "nebula-scanner",
  "main": "workers/nebula-scanner.mjs",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "STAGE_DB",
      "database_name": "nebula-db",
      "database_id": "6eeadd5e-5e58-4a8c-90d9-92d039438a8f",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "MARKET_API",
      "service": "nebula-api"
    },
    {
      "binding": "AI_ENGINE",
      "service": "nebula-ai-engine"
    }
  ],
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "INTERNAL_TOKEN",
      "MANUAL_SCAN_TOKEN"
    ]
  }
}
